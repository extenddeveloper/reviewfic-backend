PORT=5001
NIXPACKS_NODE_VERSION=22
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
RETURN_URL=https://app.framefic.com/reviewfic

# ------------------------------------------------------------------------------
# MySQL Database Configuration (Laragon / Local MySQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=framefic-reviewfic
DB_USER=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key

# ------------------------------------------------------------------------------
# Google OAuth Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# Stripe Billing & Pricing Configuration
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...

TRIAL_DURATION_DAYS=7
LIFETIME_DEAL_MAX_USERS=20

# ------------------------------------------------------------------------------
# SMTP Email Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=Framefic <hello@framefic.com>
TEAM_NOTIFICATION_EMAIL=hello@framefic.com
BYPASS_TEAM_MAIL=true

# ------------------------------------------------------------------------------
# CRM & Webhooks
# ------------------------------------------------------------------------------
CRMFIC_WEBHOOK_URL=https://beta.crmfic.com/api/webhooks/receive/...
CRMFIC_AUTO_SYNC_INTERVAL_MINUTES=10
WEBHOOK_URL=https://framefic.com/wp-json/mailerpress/v1/webhooks/receive/...

# ------------------------------------------------------------------------------
# Google Places & Trustpilot Reviews Integration
